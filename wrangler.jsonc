{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sb05-reviews-api",
  "account_id": "8bb04fb9d237ef2eec26acbb6ddca6ab",
  "main": "cloudflare/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "build": {
    "command": "node build-cloudflare.cjs"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SB05_UPLOADER_EMAIL": "eslam.mansour@ymail.com",
    "FORMA_SYNC_ENABLED": "true",
    "FORMA_BATCHED": "true"
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REVIEW_STATE",
        "class_name": "SB05State"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SB05State"
      ]
    }
  ]
}
